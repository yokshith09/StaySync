# Copy to .env and fill in. Never commit the real file.

# --- Transport A: Supabase over HTTPS (port 443) -----------------------------
# Use this where outbound 5432 is blocked. SUPABASE_SECRET_KEY must be the
# SECRET (service_role) key from Dashboard > Project Settings > API Keys.
# It bypasses RLS, so it is server-side only and must never reach a browser.
# Takes precedence over DATABASE_URL when both are set.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# --- Transport B: direct Postgres driver (port 5432) -------------------------
# Supabase pooler: postgresql://<role>.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Cloud SQL socket: postgresql://<user>:<pw>@/<db>?host=/cloudsql/<project>:<region>:<instance>
DATABASE_URL=

# Leave both unset to run fully in memory (what `npm start` and `npm test` do).
NODE_ENV=development
PORT=8081
